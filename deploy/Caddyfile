{
	admin off
	auto_https off
}

:8080 {
	log {
		output stdout
		format json
	}

	handle /healthz {
		respond "ok" 200
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /health/* {
		reverse_proxy api:3000
	}

	handle /diagnostics/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:5173
	}
}
