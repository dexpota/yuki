# Development-only defaults are built into compose.yaml. Copy this file to
# deploy/.env when values need to be overridden locally.
YUKI_HTTP_BIND_ADDRESS=127.0.0.1
YUKI_HTTP_PORT=8080

YUKI_POSTGRES_DB=yuki
YUKI_POSTGRES_USER=yuki
# Replace this value whenever the deployment is reachable by another machine.
YUKI_POSTGRES_PASSWORD=yuki-development-only

# Development-only keys. Replace both with independent `openssl rand -base64 32`
# values before exposing Yuki beyond this machine, then keep them stable.
YUKI_CSRF_KEY=CwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCws=
YUKI_MASTER_KEY=FhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhY=
YUKI_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Used by the API and worker once their application containers are enabled.
YUKI_STORAGE_ROOT=/data/yuki
YUKI_MAXIMUM_UPLOAD_BYTES=2147483648
YUKI_UPLOAD_PROGRESS_INTERVAL_BYTES=1048576
YUKI_IMPORT_POLL_INTERVAL_MS=1000
YUKI_IMPORT_JOB_LEASE_MS=30000
