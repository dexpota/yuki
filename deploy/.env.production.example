# Copy to a private file outside version control. All four image references
# come from a single release-images.json v2 asset via select-release.mjs.
YUKI_BACKEND_IMAGE=
YUKI_WEB_IMAGE=
YUKI_PROCESSOR_IMAGE=
YUKI_SUPERVISOR_IMAGE=
YUKI_RELEASE_VERSION=
YUKI_RELEASE_REVISION=

YUKI_HTTP_BIND_ADDRESS=127.0.0.1
YUKI_HTTP_PORT=8080
YUKI_POSTGRES_DB=yuki
YUKI_POSTGRES_USER=yuki
YUKI_POSTGRES_PASSWORD=
# URL-encode reserved characters in the password inside this URL.
YUKI_DATABASE_URL=
YUKI_CSRF_KEY=
YUKI_MASTER_KEY=
YUKI_PROCESSOR_TOKEN=
YUKI_ALLOWED_ORIGINS=

YUKI_STORAGE_BACKEND=local
# For S3, set endpoint, region, bucket, access key, and secret access key.
YUKI_S3_ENDPOINT=
YUKI_S3_REGION=
YUKI_S3_BUCKET=
YUKI_S3_ACCESS_KEY_ID=
YUKI_S3_SECRET_ACCESS_KEY=

# Unique for each Compose stack on the Docker host.
YUKI_PROCESSOR_WORKSPACE_VOLUME=yuki_processor_jobs
