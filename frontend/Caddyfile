{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip
	root * /srv

	handle /healthz {
		respond "ok" 200
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /health/* {
		reverse_proxy api:3000
	}

	handle /diagnostics/* {
		reverse_proxy api:3000
	}

	handle {
		@versionedAssets path /assets/*
		header @versionedAssets Cache-Control "public, max-age=31536000, immutable"

		@notVersionedAssets not path /assets/*
		header @notVersionedAssets Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
